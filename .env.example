# Copia este archivo como .env y rellénalo. NUNCA lo subas a ningún sitio.

# --- Cámara (cuenta de cámara creada en la app Tapo: Ajustes avanzados → Cuenta de la cámara)
CAM_IP=192.168.1.50
CAM_PORT=554
CAM_USER=usuario_de_la_camara
CAM_PASS=contraseña_de_la_camara
CAM_STREAM=stream2            # stream2 = baja resolución (recomendado), stream1 = alta

# --- Tu red y tu usuario
HOST_IP=192.168.1.10          # IP del servidor/NAS donde corre Tapoli (para el directo WebRTC)
PANEL_URL=http://192.168.1.10:8095
PUID=1000                     # tu usuario y grupo (en Synology: id en SSH); los archivos serán tuyos
PGID=100
TZ=Europe/Madrid

# --- Resumen matutino por Telegram (opcional). Crea un bot con @BotFather y vincula
#     tu móvil desde la app: Ajustes → Resumen por Telegram.
TELEGRAM_BOT_TOKEN=

# --- Solo si publicas con tools/deploy.sh a través de Portainer (opcional)
PORTAINER_URL=http://localhost:9000
PORTAINER_ENDPOINT=1
PORTAINER_STACK=
PORTAINER_TOKEN_FILE=~/.tapoli-portainer-token
