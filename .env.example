# Copy this file to .env and fill it in. NEVER commit or share it.

# --- Camera (camera account created in the Tapo app: Settings → Advanced settings → Camera account)
CAM_IP=192.168.1.50
CAM_PORT=554
CAM_USER=camera_user
CAM_PASS=camera_password
CAM_STREAM=stream2            # stream2 = low resolution (recommended), stream1 = high

# --- Your network and user
HOST_IP=192.168.1.10          # IP of the server/NAS running Tapoli (used for the WebRTC live view)
PANEL_URL=http://192.168.1.10:8095
PUID=1000                     # your user and group IDs (run `id` over SSH); files will belong to you
PGID=100
TZ=Europe/Madrid

# --- Morning summary via Telegram (optional). Create a bot with @BotFather, then link
#     your phone from the app: Ajustes → Resumen por Telegram.
TELEGRAM_BOT_TOKEN=

# --- Only if you deploy with tools/deploy.sh through Portainer (optional)
PORTAINER_URL=http://localhost:9000
PORTAINER_ENDPOINT=1
PORTAINER_STACK=
PORTAINER_TOKEN_FILE=~/.tapoli-portainer-token
